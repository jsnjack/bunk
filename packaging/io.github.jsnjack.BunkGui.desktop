[Desktop Entry]
Type=Application
Name=bunk-gui
GenericName=Terminal
Comment=Run coding agents in tabs and splits, with their documents beside them
Exec=bunk-gui
Icon=io.github.jsnjack.BunkGui
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;shell;prompt;command;agent;claude;copilot;codex;tabs;split;
StartupNotify=true
StartupWMClass=io.github.jsnjack.BunkGui
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=bunk-gui
